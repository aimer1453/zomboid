; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="晶石禁区"
config/description="末世生存回合制战术RPG"
config/version="0.1.0"
run/main_scene="res://scenes/home_base.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://autoload/game_manager.gd"
TurnManager="*res://autoload/turn_manager.gd"
WorldTime="*res://autoload/world_time.gd"
DataManager="*res://autoload/data_manager.gd"
PartyManager="*res://autoload/party_manager.gd"
InventoryBackpack="*res://autoload/inventory_backpack.gd"
SoundManager="*res://autoload/sound_manager.gd"
WorldMapData="*res://scripts/world/world_map_data.gd"
BuildingManager="*res://scripts/building/building_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=2
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="晶石禁区"

